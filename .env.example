# Copy to .env and adjust for your environment.
# All variables are optional — sensible demo defaults are used when unset.

# Port for the Express API / production server
PORT=4000

# Secret used to sign authentication tokens. CHANGE THIS in production.
# Set the same value in Vercel > Project Settings > Environment Variables.
VC_SECRET=replace-with-a-long-random-string

# Where the demo JSON datastore writes.
# Locally defaults to ./data (git-ignored). On Vercel it automatically uses
# /tmp/vctopup-data because the project filesystem is read-only.
# VC_DATA_DIR=/tmp/vctopup-data

# Set to "production" when running `npm start`.
# Vercel sets NODE_ENV=production and VERCEL=1 automatically — do not set them.
# NODE_ENV=production
