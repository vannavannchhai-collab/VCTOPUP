# ============================================================================
# VC TOPUP — environment variables
# Copy to .env (or run `npm run setup:live`) and set the SAME values in
# Vercel > Project Settings > Environment Variables for production.
# NEVER commit real credentials. .env / .env.local are git-ignored.
#
# IMPORTANT: every value below is a PLACEHOLDER. The live readiness gate rejects
# placeholders, demo strings and short secrets. No real account or API key is
# included in this repository — they must be issued to YOUR verified business.
# ============================================================================

# ---------------------------------------------------------------- core server
PORT=4000

# Optional, local-only design preview: shows template products and sample prices.
# Checkout and orders remain disabled. Never enable in production; Vercel ignores it.
# Set CATALOG_PREVIEW=true only in a local developer environment.
CATALOG_PREVIEW=false

# Long random signing secret. Generate with `openssl rand -hex 32`.
VC_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX

# Hosted Postgres connection string. REQUIRED for live payments on Vercel:
# Functions have a read-only, ephemeral filesystem. Add ?sslmode=require.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional local JSON store path (local development only; not durable or production-safe).
# VC_DATA_DIR=/tmp/vctopup-data

# Public HTTPS origin, no trailing slash. Used for the provider webhook.
# PUBLIC_BASE_URL=https://your-domain.com

# ---------------------------------------------------------------- payment mode
# live = real-money mode. The app fails closed until real merchant/provider
# credentials, durable DB, real mapped items and freshly synced prices exist.
# sandbox is for isolated developer testing only and is not used by customers.
PAYMENT_MODE=live

# ------------------------------------------------------- Bakong KHQR (NBC)
# 1. Open a KYC-verified Bakong merchant account: https://bakong.nbc.gov.kh
# 2. Register for the Open API developer token: https://api-bakong.nbc.gov.kh/register/
#    NBC emails the token; renew it before expiry via /v1/renew_token.
# 3. Use YOUR OWN account ID, e.g. `shopname@aba`, from the Bakong app.
#
# Production base (Cambodia IP restriction — confirm with NBC before deploying):
# BAKONG_API_BASE=https://api-bakong.nbc.gov.kh/v1
# Sandbox base: https://sit-api-bakong.nbc.gov.kh/v1
BAKONG_API_TOKEN=REPLACE_WITH_NBC_DEVELOPER_TOKEN
BAKONG_ACCOUNT_ID=REPLACE_WITH_YOUR_BAKONG_ID_AT_BANK
BAKONG_MERCHANT_NAME=REPLACE_WITH_REGISTERED_BUSINESS_NAME
BAKONG_MERCHANT_CITY=REPLACE_WITH_MERCHANT_CITY
# Optional (tag 30 merchant QR for some acquiring banks):
# BAKONG_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
# BAKONG_ACQUIRING_BANK=REPLACE_WITH_BANK_NAME
BAKONG_CURRENCY=USD
# Only needed for KHR settlement: set a verified, regularly maintained rate.
# BAKONG_KHR_PER_USD=REPLACE_WITH_CURRENT_RATE
BAKONG_QR_TTL_MINUTES=10
BAKONG_POLL_THROTTLE_MS=4000

# ------------------------------------- REAL DIAMONDS — Shop2Topup (recommended)
# Register a real reseller account at https://portal.shop2topup.com, fund its
# wallet, enable API Access, and generate `<keyId>.<secret>`. The secret is
# shown once. Register the webhook URL below in the reseller panel and copy the
# webhook signing secret. Docs: https://shop2topup.com/en/reseller-api
PARTNER_PROVIDER=shop2topup
# SHOP2TOPUP_BASE_URL=https://shop2topup.com/api/endpoints/v1
SHOP2TOPUP_API_KEY=2Eg6V2K2NL55M58FTlWJKA.1xHmWA-08I2hMnKAejHrritSspsyECOvHYlpMp_ymcnjZ394v0dqP5t9skqlt1xR
SHOP2TOPUP_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# Category whose `requirements` describe Player ID / Server fields.
# Find IDs with `npm run partner:catalog`.
# SHOP2TOPUP_CATEGORY_ID=12
# Optional server/region default when a game requires one.
# SHOP2TOPUP_DEFAULT_SERVER=Asia
# Optional: skip player validation only if your provider contract says so.
SHOP2TOPUP_VALIDATE_PLAYER=true
# Refuse fulfillment if provider unit cost exceeds this fraction of retail price.
SHOP2TOPUP_MAX_COST_RATIO=1
# 50% markup: displayed retail price = provider unit price × 1.5.
# Change this only after choosing your intended margin.
SHOP2TOPUP_RETAIL_MULTIPLIER=1.5
SHOP2TOPUP_TIMEOUT_MS=15000

# Instead of the Admin UI, package → numeric item ID mappings may be set here.
# Keys: "<productSlug>:<packageId>" or "<productSlug>". Values: numeric IDs.
# SHOP2TOPUP_ITEM_MAP={"mobile-legends:86-diamonds":"12345","free-fire:100-diamonds":"67890"}

# ------------------------------------- alternative: generic signed partner API
# Set PARTNER_PROVIDER=generic to use this instead of Shop2Topup.
# The adapter signs: sha256=HMAC(secret, `${timestamp}.${rawBody}`).
# PARTNER_API_URL=https://api.your-official-partner.com/v1/topup
# PARTNER_API_KEY=REPLACE_WITH_PARTNER_KEY
# PARTNER_API_SECRET=REPLACE_WITH_PARTNER_HMAC_SECRET
# PARTNER_CALLBACK_SECRET=REPLACE_WITH_CALLBACK_HMAC_SECRET
# PARTNER_TIMEOUT_MS=15000
# PARTNER_SKU_MAP={"mobile-legends:86-diamonds":"OFFICIAL_MLBB_86"}

# ------------------------------------------------------- crash recovery / cron
# Protects GET /api/payments/reconcile. Generate with `openssl rand -hex 32`.
# On Vercel, a CRON_SECRET env var is automatically sent as a Bearer header.
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_HEX

# ----------------------------------------------------------- social sign-up/login
# Google Identity Services: create a Web OAuth client and register your exact
# HTTPS site origin + redirect/origin URLs in Google Cloud Console.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# Telegram: create your bot with @BotFather, set the website domain with
# /setdomain, and use the matching bot username + token. Keep token server-side.
TELEGRAM_BOT_USERNAME=REPLACE_WITH_TELEGRAM_BOT_USERNAME
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# ------------------------------------------------------------ first admin user
# Create the first admin through `npm run admin:create` after DATABASE_URL is set.
# Do not seed a shared/default administrator password.

# ------------------------------------------------------------------ Vercel only
# Vercel sets NODE_ENV=production and VERCEL=1 automatically. Do NOT set them.
