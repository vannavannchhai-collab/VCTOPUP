# ============================================================================
# VC TOPUP — environment variables
# Copy to .env for local development, and set the SAME values in
# Vercel > Project Settings > Environment Variables for production.
# NEVER commit real credentials. .env is git-ignored.
# ============================================================================

# ---------------------------------------------------------------- core server
# Port for the Express API / local production server (ignored on Vercel).
PORT=4000

# Secret used to sign auth tokens. REQUIRED for live mode — use a long random
# string: `openssl rand -hex 32`. Changing it invalidates all existing logins.
VC_SECRET=replace-with-a-long-random-string

# Postgres connection string. REQUIRED FOR LIVE PAYMENTS on Vercel.
# Vercel Functions have a read-only, ephemeral filesystem, so without a hosted
# database orders (and money) can be lost on a cold start.
# Providers: Neon, Supabase, Vercel Postgres, Railway. Add ?sslmode=require.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional override for the local JSON store path.
# VC_DATA_DIR=/tmp/vctopup-data

# Public origin, used to build the partner callback URL. No trailing slash.
# PUBLIC_BASE_URL=https://your-domain.com

# ---------------------------------------------------------------- payment mode
# sandbox = NO REAL MONEY. Generates valid-format KHQR strings against a sandbox
#           merchant account, verifies via /api/payments/:code/simulate, and
#           simulates partner delivery. Default. Safe to deploy.
# live    = REAL MONEY + REAL DIAMONDS. Refuses to create orders until every
#           value in `integrationStatus().checks` passes (fails closed).
PAYMENT_MODE=sandbox

# ------------------------------------------------------- Bakong KHQR (NBC)
# 1. Register a KYC-verified Bakong account: https://bakong.nbc.gov.kh
# 2. Register for the Open API developer token: https://api-bakong.nbc.gov.kh/register/
#    (NBC emails the token; it expires ~90 days — renew via /v1/renew_token)
# 3. Your Bakong Account ID looks like `your_name@aba` (find it in the app).
#
# Sandbox API: https://sit-api-bakong.nbc.gov.kh/v1
# Live API:    https://api-bakong.nbc.gov.kh/v1  (Cambodia IP restriction!)
# BAKONG_API_BASE=https://sit-api-bakong.nbc.gov.kh/v1
BAKONG_API_TOKEN=your-nbc-developer-token
BAKONG_ACCOUNT_ID=your_store@bank
BAKONG_MERCHANT_NAME=VC TOPUP
BAKONG_MERCHANT_CITY=Siem Reap
# Optional — when set, a MERCHANT (tag 30) KHQR is generated instead of an
# individual one (tag 29). Required by some acquiring banks.
# BAKONG_MERCHANT_ID=MERCHANT001
# BAKONG_ACQUIRING_BANK=ABA Bank
BAKONG_CURRENCY=USD
# NBC guidance: dynamic KHQR should expire within ~10 minutes.
BAKONG_QR_TTL_MINUTES=10
# Minimum gap between server-to-server verification calls, per QR.
BAKONG_POLL_THROTTLE_MS=4000

# ------------------------------------------- official game partner / supplier
# Your publisher/partner top-up endpoint. The adapter signs every request:
#   X-Api-Key, X-Timestamp, X-Signature: sha256=hmac(secret, `${ts}.${body}`)
#   Idempotency-Key: <order code>   <-- prevents double-crediting on retry
# PARTNER_API_URL=https://api.your-partner.com/v1/topup
PARTNER_API_KEY=your-partner-api-key
PARTNER_API_SECRET=your-partner-hmac-secret
# Optional separate secret for inbound callbacks; defaults to PARTNER_API_SECRET.
# PARTNER_CALLBACK_SECRET=your-callback-hmac-secret
PARTNER_TIMEOUT_MS=15000

# Map our packages to the partner's real SKU codes (JSON, no newlines).
# Keys: "<productSlug>:<packageId>" or just "<productSlug>".
# PARTNER_SKU_MAP={"mobile-legends:86-diamonds":"MOONTON_MLBB_86","free-fire:100-diamonds":"GARENA_FF_100"}

# Secret protecting GET /api/payments/reconcile (the crash-recovery sweep).
# Call it from a scheduler: curl -H "Authorization: Bearer $CRON_SECRET" \
#   https://your-domain.com/api/payments/reconcile
CRON_SECRET=replace-with-another-long-random-string

# ------------------------------------------------------------------ Vercel only
# Vercel sets NODE_ENV=production and VERCEL=1 automatically. Do NOT set them.
# NODE_ENV=production
